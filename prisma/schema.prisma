// VOX Cognitive Operating System — Phase 1 domain model.
// Smallest coherent schema that supports the documented Phase 1 features
// while leaving room for future extension (see ARCHITECTURE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

/// Confidence is always explicit and visible — VOX never silently upgrades
/// an inference to a confirmed fact.
enum Confidence {
  LOW
  MEDIUM
  HIGH
  CONFIRMED
}

/// Explicit agency levels. Default policy is OBSERVE/ANALYZE; RECOMMEND, ASK
/// and ACT require an explicit granted Permission row.
enum CapabilityLevel {
  OBSERVE
  ANALYZE
  RECOMMEND
  ASK
  ACT
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  conversations   Conversation[]
  memories        Memory[]
  memoryRelations MemoryRelation[]
  observations    Observation[]
  hypotheses      Hypothesis[]
  patterns        Pattern[]
  goals           Goal[]
  projects        Project[]
  tasks           Task[]
  decisions       Decision[]
  ideas           Idea[]
  experiments     Experiment[]
  researchItems   ResearchItem[]
  knowledgeNodes  KnowledgeNode[]
  knowledgeEdges  KnowledgeConnection[]
  permissions     Permission[]
  connections     Connection[]
  events          Event[]
  proposals       Proposal[]
  agentRuns             AgentRun[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  objectives            Objective[]
  opportunities         Opportunity[]
}

/// Server-side sessions (not JWTs) so they can be listed, inspected and
/// revoked from Settings — part of the privacy/audit surface.
model Session {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ---------------------------------------------------------------------------
// Conversation & chat memory
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String   @default("New conversation")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           MessageRole
  content        String
  /// AI provider + model id that produced this message, e.g. "anthropic:claude-...".
  model          String?
  /// Research/tool activity or uncertainty notes surfaced to the user (JSON).
  meta           String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())

  memorySources MemorySource[]
}

// ---------------------------------------------------------------------------
// Memory system
// ---------------------------------------------------------------------------

enum MemoryCategory {
  FACT
  PREFERENCE
  GOAL
  PROJECT
  EXPERIENCE
  IDEA
  OBSERVATION
  HYPOTHESIS
  INFERENCE
  TEMPORARY_CONTEXT
}

model Memory {
  id           String         @id @default(uuid())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  content      String
  category     MemoryCategory
  confidence   Confidence     @default(MEDIUM)
  /// Free-text provenance note in addition to the structured MemorySource row.
  provenance   String?
  /// Set when another Memory supersedes this one (see MemoryRelation). Superseded
  /// memories stay inspectable/exportable but drop out of default retrieval.
  supersededAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  source            MemorySource?
  embedding         MemoryEmbedding?
  knowledgeNode     KnowledgeNode?
  outgoingRelations MemoryRelation[] @relation("FromMemory")
  incomingRelations MemoryRelation[] @relation("ToMemory")
}

/// Vector representation of a Memory's (decrypted, in-process) content, used for
/// semantic retrieval. A satellite table so re-embedding with a different
/// provider never touches the encrypted Memory row. Vectors are NOT encrypted —
/// see SECURITY.md for why, and what that trades away.
model MemoryEmbedding {
  id         String   @id @default(uuid())
  memory     Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  memoryId   String   @unique
  /// e.g. "local-hashed-256", "voyage-3".
  provider   String
  dimensions Int
  /// JSON-encoded float array.
  vector     String
  createdAt  DateTime @default(now())
}

enum MemoryRelationType {
  RELATES_TO
  SUPERSEDES
  CONTRADICTS
  DERIVED_FROM
  SUPPORTS
}

/// Explicit, always-human-or-detector-created relationships between memories.
/// Never written silently — contradiction detection proposes these via the
/// Proposal system rather than writing them directly.
model MemoryRelation {
  id           String             @id @default(uuid())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  fromMemory   Memory             @relation("FromMemory", fields: [fromMemoryId], references: [id], onDelete: Cascade)
  fromMemoryId String
  toMemory     Memory             @relation("ToMemory", fields: [toMemoryId], references: [id], onDelete: Cascade)
  toMemoryId   String
  type         MemoryRelationType
  note         String?
  confidence   Confidence         @default(LOW)
  createdAt    DateTime           @default(now())
}

enum MemorySourceType {
  USER_STATED
  CONVERSATION
  RESEARCH
  INFERENCE
  SYSTEM
}

model MemorySource {
  id             String           @id @default(uuid())
  memory         Memory           @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  memoryId       String           @unique
  type           MemorySourceType
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageId      String?
  researchItem   ResearchItem?    @relation(fields: [researchItemId], references: [id], onDelete: SetNull)
  researchItemId String?
  /// Free-form description of the source when it isn't a message/research item.
  reference      String?
  createdAt      DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Cognitive model: observations, hypotheses, recurring patterns
// ---------------------------------------------------------------------------

enum CognitiveDimension {
  FOCUS
  TASK_SWITCHING
  COMPLETION_BEHAVIOR
  IDEA_GENERATION
  CREATIVITY
  LEARNING_BEHAVIOR
  DECISION_BEHAVIOR
  PLANNING_BEHAVIOR
  CONSISTENCY
  PROJECT_PERSISTENCE
  ATTENTION_PATTERNS
  PRODUCTIVITY_PATTERNS
}

model Observation {
  id         String             @id @default(uuid())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  dimension  CognitiveDimension
  content    String
  evidence   String?
  confidence Confidence         @default(LOW)
  createdAt  DateTime           @default(now())
}

enum HypothesisStatus {
  OPEN
  SUPPORTED
  REJECTED
}

model Hypothesis {
  id         String              @id @default(uuid())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  dimension  CognitiveDimension?
  statement  String
  confidence Confidence          @default(LOW)
  status     HypothesisStatus    @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

enum PatternType {
  REPEATED_IDEA
  EXCESSIVE_BRANCHING
  RECONSIDERATION
  TASK_SWITCHING
  UNRESOLVED_DECISION
  IDEA_WITHOUT_EXECUTION
  PROJECT_ABANDON_RETURN
  OTHER
}

enum PatternStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

/// "Thought-loop" / recurring-pattern detection. Always phrased as a
/// hypothesis ("pattern detected", "possible loop") — never a diagnosis.
model Pattern {
  id              String        @id @default(uuid())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  type            PatternType
  description     String
  confidence      Confidence    @default(LOW)
  status          PatternStatus @default(ACTIVE)
  occurrenceCount Int           @default(1)
  firstDetectedAt DateTime      @default(now())
  lastDetectedAt  DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Projects, goals, tasks, decisions, ideas
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Project {
  id          String        @id @default(uuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  goals         Goal[]
  tasks         Task[]
  decisions     Decision[]
  ideas         Idea[]
  experiments   Experiment[]
  conversations Conversation[]
  knowledgeNode KnowledgeNode?
  agentRuns     AgentRun[]
  opportunities Opportunity[]
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ABANDONED
}

model Goal {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  knowledgeNode KnowledgeNode?
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

model Task {
  id          String       @id @default(uuid())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  // All four below are optional and unset (null) until the user provides
  // them — never inferred or defaulted to a fabricated value. The Brain's
  // task-neuron detail panel shows "not set" rather than guessing.
  difficulty       TaskDifficulty?
  estimatedMinutes Int?
  pros             String? // JSON string[]
  cons             String? // JSON string[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  knowledgeNode KnowledgeNode?
}

enum DecisionStatus {
  PENDING
  DECIDED
  REVISITED
}

model Decision {
  id           String         @id @default(uuid())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId    String?
  title        String
  description  String?
  /// JSON array of alternatives considered.
  alternatives String?
  chosenOption String?
  status       DecisionStatus @default(PENDING)
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  knowledgeNode KnowledgeNode?
}

enum IdeaStatus {
  CAPTURED
  EXPLORING
  IN_EXPERIMENT
  EXECUTED
  ABANDONED
}

model Idea {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  description String?
  status      IdeaStatus @default(CAPTURED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  experiments   Experiment[]
  knowledgeNode KnowledgeNode?
}

// ---------------------------------------------------------------------------
// Experiments
// ---------------------------------------------------------------------------

enum ExperimentStatus {
  PLANNED
  RUNNING
  COMPLETED
  ABANDONED
}

model Experiment {
  id         String           @id @default(uuid())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  idea       Idea?            @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  ideaId     String?
  hypothesis String
  method     String?
  status     ExperimentStatus @default(PLANNED)
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  results       ExperimentResult[]
  knowledgeNode KnowledgeNode?
}

model ExperimentResult {
  id           String     @id @default(uuid())
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  experimentId String
  outcome      String
  learnings    String?
  confidence   Confidence @default(MEDIUM)
  createdAt    DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// Research
// ---------------------------------------------------------------------------

model ResearchItem {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  query       String
  provider    String
  title       String?
  sourceUrl   String?
  summary     String?
  relevance   Float?
  confidence  Confidence @default(MEDIUM)
  /// Set when this research was run in the context of a specific Opportunity
  /// (e.g. from the Brain workspace) — null for general/unscoped research.
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  opportunityId String?
  retrievedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())

  memorySources MemorySource[]
  knowledgeNode KnowledgeNode?
}

// ---------------------------------------------------------------------------
// Minimal knowledge graph
// ---------------------------------------------------------------------------

enum KnowledgeNodeType {
  ENTITY
  TOPIC
  PROJECT
  GOAL
  CONCEPT
  PERSON
  ORGANIZATION
  OTHER
}

/// A node either mirrors a first-class VOX record (exactly one of the link
/// columns below is set — real FK, real cascade-delete) or is a free-floating
/// entity the record model doesn't cover (Person/Organization/Concept/Topic —
/// all link columns null). Prisma has no native polymorphic association, and
/// a string-typed entityId would give up referential integrity, so this is
/// explicit columns rather than a generic entityType/entityId pair.
model KnowledgeNode {
  id          String            @id @default(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  label       String
  type        KnowledgeNodeType @default(ENTITY)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  memoryId       String?       @unique
  memory         Memory?       @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  projectId      String?       @unique
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goalId         String?       @unique
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  taskId         String?       @unique
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  decisionId     String?       @unique
  decision       Decision?     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  ideaId         String?       @unique
  idea           Idea?         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  experimentId   String?       @unique
  experiment     Experiment?   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  researchItemId String?       @unique
  researchItem   ResearchItem? @relation(fields: [researchItemId], references: [id], onDelete: Cascade)

  outgoing KnowledgeConnection[] @relation("FromNode")
  incoming KnowledgeConnection[] @relation("ToNode")
}

model KnowledgeConnection {
  id         String        @id @default(uuid())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  fromNode   KnowledgeNode @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  fromNodeId String
  toNode     KnowledgeNode @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  /// Short relation label, e.g. "owns", "related_to", "goal".
  relation   String
  createdAt  DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Permissions, integrations, audit events
// ---------------------------------------------------------------------------

model Permission {
  id         String          @id @default(uuid())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  /// Scoped capability key, e.g. "research.web", "integration.gmail.send".
  capability String
  level      CapabilityLevel @default(OBSERVE)
  granted    Boolean         @default(false)
  grantedAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, capability])
}

// ---------------------------------------------------------------------------
// Connections Hub — external-integration trust/control layer (Phase 2.5)
// ---------------------------------------------------------------------------
//
// Every future external capability (email, calendar, financial data, tasks,
// health, location, shopping, print-on-demand, ...) is represented here as a
// Connection, gated by the same Permission/enforceCapability() system used
// everywhere else. Connections start at NOT_CONNECTED and can only reach
// CONNECTED through explicit user approval — see SECURITY.md. No provider in
// this codebase can complete that transition until real vendor credentials
// are supplied via environment variables; see src/lib/integrations/.

enum ConnectionCategory {
  EMAIL_CALENDAR
  FINANCIAL
  TASKS_NOTES
  HEALTH_FITNESS
  LOCATION_MAPS
  SHOPPING
  ETSY
  PRINT_ON_DEMAND
}

enum ConnectionService {
  GOOGLE_CALENDAR
  GOOGLE_GMAIL
  NOTION
  TODOIST
  CRAFT
  QUICKBOOKS
  PLAID
  APPLE_HEALTH
  GOOGLE_FIT
  GOOGLE_MAPS
  AMAZON_ORDERS
  ETSY
  PRINTFUL
  PRINTIFY
}

/// NOT_CONNECTED -> PROPOSED -> AWAITING_APPROVAL -> CONNECTING -> CONNECTED
/// -> PAUSED / REVOKED. ERROR can follow a failed CONNECTING attempt. Nothing
/// in this codebase can currently drive a connection past AWAITING_APPROVAL —
/// see src/lib/integrations/stub.ts.
enum ConnectionStatus {
  NOT_CONNECTED
  PROPOSED
  AWAITING_APPROVAL
  CONNECTING
  CONNECTED
  PAUSED
  REVOKED
  ERROR
}

model Connection {
  id              String             @id @default(uuid())
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  category        ConnectionCategory
  service         ConnectionService
  displayName     String
  status          ConnectionStatus   @default(NOT_CONNECTED)
  /// Permission capability key for read access, e.g. "integration.google_calendar.read".
  readCapability  String
  /// Permission capability key for write access, or null if this service has no write mode.
  writeCapability String?
  /// Denormalized mirror of the read Permission grant, kept in sync by src/lib/connections/service.ts.
  readEnabled     Boolean            @default(false)
  writeEnabled    Boolean            @default(false)
  /// Why this was suggested, or the last connect/error message.
  statusReason    String?
  lastSyncedAt    DateTime?
  /// Non-secret JSON configuration only — never store API keys/tokens here.
  config          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  credential  ConnectionCredential?
  cachedItems ConnectionCachedItem[]

  @@unique([userId, service])
}

/// Encrypted OAuth/API credentials for a Connection. Deleted outright (not
/// flagged) by revokeConnection() — see SECURITY.md.
model ConnectionCredential {
  id               String     @id @default(uuid())
  connection       Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId     String     @unique
  /// encryptField()-encoded JSON: access/refresh token, scope, etc.
  encryptedPayload String
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

/// Cached external data fetched through a Connection — same sensitivity as
/// Memory.content, so it's encrypted the same way. Deletable independently of
/// revoking the connection itself via deleteCachedData().
model ConnectionCachedItem {
  id           String     @id @default(uuid())
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String
  externalId   String
  /// e.g. "event", "email", "task", "transaction", "order".
  kind         String
  /// encryptField()-encoded external content.
  payload      String
  fetchedAt    DateTime   @default(now())

  @@unique([connectionId, externalId])
}

/// Append-only audit log AND durable domain timeline: every consequential
/// (RECOMMEND/ASK/ACT-level) action is recorded here, as is every notable
/// domain state change (task completed, goal changed, research discovered,
/// memory updated/superseded, decision made, experiment result, project
/// milestone). `subjectId` is intentionally NOT a foreign key — an event
/// describing a deleted record must still be readable after that record is
/// gone.
model Event {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  type          String
  /// JSON payload with event-specific details.
  payload       String?
  /// Descriptive-only, e.g. "Task" / "Goal" / "Memory" — not a foreign key.
  subjectType   String?
  subjectId     String?
  consequential Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Cognition proposal engine
// ---------------------------------------------------------------------------

enum ProposalStatus {
  PROPOSED
  APPROVED
  DENIED
  EXPIRED
  EXECUTED
  FAILED
}

/// "Observed X. Connected it with Y. Possible implication: Z. Suggested
/// action: A. Permission required." A Proposal is always PROPOSED first;
/// nothing here executes without approveProposal() succeeding a real
/// enforceCapability() check (src/lib/permissions/service.ts) — see
/// PHASE_2_ARCHITECTURE.md §5.
model Proposal {
  id              String          @id @default(uuid())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  observation     String
  connection      String?
  implication     String?
  suggestedAction String
  /// Machine key into the fixed, internal-only action registry, e.g.
  /// "memory.create_relation", "task.create".
  actionType      String
  /// JSON — concrete params passed to the action handler if approved.
  actionPayload   String
  /// Permission capability key checked before executing.
  capability      String
  requiredLevel   CapabilityLevel @default(RECOMMEND)
  confidence      Confidence      @default(LOW)
  /// JSON: { memoryIds, researchItemIds, observationIds, eventIds }
  evidence        String?
  status          ProposalStatus  @default(PROPOSED)
  /// Outcome text once executed, or the denial reason.
  result          String?
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?
}

// ---------------------------------------------------------------------------
// Agent engine (Phase 4) — objective -> plan -> steps -> execution
// ---------------------------------------------------------------------------
//
// Deliberately sequential (ordered by AgentStep.order), not a general DAG —
// covers the real "step N depends on step N-1" case without building a full
// dependency graph nobody asked for yet. Every step that reaches an external
// or mutating tool goes through the exact same enforceCapability() as
// everything else in VOX (src/lib/permissions/service.ts) — the agent engine
// is a new caller of the permission system, not a new gate.

enum AgentRunStatus {
  PLANNING
  WAITING_FOR_PERMISSION
  RUNNING
  WAITING
  FAILED
  COMPLETED
  CANCELLED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  WAITING_FOR_PERMISSION
  COMPLETED
  FAILED
  SKIPPED
}

model AgentRun {
  id          String         @id @default(uuid())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  objective   String
  status      AgentRunStatus @default(PLANNING)
  /// Index into `steps` (order value) the executor is currently on / paused at.
  currentStep Int            @default(0)
  /// Final synthesized outcome once COMPLETED.
  result      String?
  /// Failure reason once FAILED.
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  steps AgentStep[]
}

/// One planned unit of work within an AgentRun. `toolName` references a
/// key in the code-level tool registry (src/lib/tools/registry.ts) — tools
/// are not a DB table, matching the existing closed-registry pattern used by
/// the Proposal engine's ACTION_HANDLERS, just made discoverable/generic.
model AgentStep {
  id            String          @id @default(uuid())
  run           AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId         String
  order         Int
  description   String
  toolName      String?
  /// JSON — input passed to the tool.
  input         String?
  /// JSON — the tool's result, once executed.
  output        String?
  status        AgentStepStatus @default(PENDING)
  /// Permission capability key this step's tool requires, if any.
  capability    String?
  requiredLevel CapabilityLevel @default(OBSERVE)
  error         String?
  retryCount    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  startedAt     DateTime?
  completedAt   DateTime?

  @@unique([runId, order])
}

// ---------------------------------------------------------------------------
// Objective & Opportunity engine — the intelligence loop
// ---------------------------------------------------------------------------
//
// An Objective is a real, user-declared outcome VOX is helping pursue (e.g.
// "generate $25,000"). It is not a Goal (Goal is a lightweight personal
// target attached to a Project) — an Objective carries strategy notes,
// explicit assumptions, and an optional numeric target, and is the anchor
// chat/dashboard use to answer "what is VOX currently helping me do." VOX
// never marks an Objective's progress or invents currentValue — progress is
// only ever what the user records via updateObjective(), same non-fabrication
// rule as Memory confidence.
//
// An Opportunity is a concrete, evaluated option toward an Objective —
// value/effort/confidence/risk/next-action, always attached to exactly one
// Objective. Nothing here executes anything: Opportunity.nextAction is text,
// and turning it into real work still goes through Task/Proposal/AgentRun
// like everything else.

enum ObjectiveStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ABANDONED
}

model Objective {
  id          String          @id @default(uuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  description String?
  /// Free-text strategy notes — human- or VOX-authored, never fabricated progress.
  strategy    String?
  /// JSON string[] of explicit assumptions the strategy depends on.
  assumptions String?
  /// Optional numeric target, e.g. 25000. Null when the objective isn't a number to hit.
  targetValue Float?
  /// Unit for targetValue, e.g. "USD". Null unless targetValue is set.
  targetUnit  String?
  /// Optional numeric progress toward targetValue. Only ever set by explicit
  /// user input via updateObjective() — never inferred or auto-incremented.
  currentValue Float?
  targetDate  DateTime?
  status      ObjectiveStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  opportunities Opportunity[]
}

enum OpportunityStatus {
  IDEA
  EVALUATING
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Opportunity {
  id          String            @id @default(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  objective   Objective         @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  objectiveId String
  title       String
  description String?
  /// Honest estimate only — left null rather than guessed when there's no basis.
  estimatedValue Float?
  effort      EffortLevel?
  confidence  Confidence        @default(LOW)
  risk        RiskLevel?
  /// The single concrete next step, in the user's or VOX's own words — not a status label.
  nextAction  String?
  /// JSON string[] — reasoning/evidence behind the estimate, so it stays inspectable.
  evidence    String?
  status      OpportunityStatus @default(IDEA)
  /// Set once this opportunity has been promoted into a real Project (Brain
  /// workspace "Create Project" action) — null until that happens.
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  researchItems ResearchItem[]
}

// ---------------------------------------------------------------------------
// Proactive intelligence — notification delivery layer (Phase 3)
// ---------------------------------------------------------------------------
//
// Pattern/Observation detection (see Pattern model above) already decides
// *what* might be worth surfacing; this is the missing delivery layer —
// whether, when, and how loudly to actually tell the user, subject to their
// own preferences. Never bypasses those preferences.

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

model Notification {
  id         String               @id @default(uuid())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  title      String
  body       String
  priority   NotificationPriority @default(NORMAL)
  /// Descriptive-only, e.g. "Pattern" / "AgentRun" — not a foreign key, same
  /// convention as Event.subjectType (must survive subject deletion).
  sourceType String?
  sourceId   String?
  projectId  String?
  read       Boolean              @default(false)
  createdAt  DateTime             @default(now())
}

model NotificationPreference {
  id              String               @id @default(uuid())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String               @unique
  enabled         Boolean              @default(true)
  /// Local hour-of-day (0-23). Both null = no quiet hours configured.
  quietHoursStart Int?
  quietHoursEnd   Int?
  /// Notifications below this priority are suppressed entirely.
  minPriority     NotificationPriority @default(LOW)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}
