// VOX Cognitive Operating System — Phase 1 domain model.
// Smallest coherent schema that supports the documented Phase 1 features
// while leaving room for future extension (see ARCHITECTURE.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

/// Confidence is always explicit and visible — VOX never silently upgrades
/// an inference to a confirmed fact.
enum Confidence {
  LOW
  MEDIUM
  HIGH
  CONFIRMED
}

/// Explicit agency levels. Default policy is OBSERVE/ANALYZE; RECOMMEND, ASK
/// and ACT require an explicit granted Permission row.
enum CapabilityLevel {
  OBSERVE
  ANALYZE
  RECOMMEND
  ASK
  ACT
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  conversations   Conversation[]
  memories        Memory[]
  memoryRelations MemoryRelation[]
  observations    Observation[]
  hypotheses      Hypothesis[]
  patterns        Pattern[]
  goals           Goal[]
  projects        Project[]
  tasks           Task[]
  decisions       Decision[]
  ideas           Idea[]
  experiments     Experiment[]
  researchItems   ResearchItem[]
  knowledgeNodes  KnowledgeNode[]
  knowledgeEdges  KnowledgeConnection[]
  permissions     Permission[]
  integrations    Integration[]
  events          Event[]
  proposals       Proposal[]
}

/// Server-side sessions (not JWTs) so they can be listed, inspected and
/// revoked from Settings — part of the privacy/audit surface.
model Session {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ---------------------------------------------------------------------------
// Conversation & chat memory
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String   @default("New conversation")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           MessageRole
  content        String
  /// AI provider + model id that produced this message, e.g. "anthropic:claude-...".
  model          String?
  /// Research/tool activity or uncertainty notes surfaced to the user (JSON).
  meta           String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())

  memorySources MemorySource[]
}

// ---------------------------------------------------------------------------
// Memory system
// ---------------------------------------------------------------------------

enum MemoryCategory {
  FACT
  PREFERENCE
  GOAL
  PROJECT
  EXPERIENCE
  IDEA
  OBSERVATION
  HYPOTHESIS
  INFERENCE
  TEMPORARY_CONTEXT
}

model Memory {
  id           String         @id @default(uuid())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  content      String
  category     MemoryCategory
  confidence   Confidence     @default(MEDIUM)
  /// Free-text provenance note in addition to the structured MemorySource row.
  provenance   String?
  /// Set when another Memory supersedes this one (see MemoryRelation). Superseded
  /// memories stay inspectable/exportable but drop out of default retrieval.
  supersededAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  source            MemorySource?
  embedding         MemoryEmbedding?
  knowledgeNode     KnowledgeNode?
  outgoingRelations MemoryRelation[] @relation("FromMemory")
  incomingRelations MemoryRelation[] @relation("ToMemory")
}

/// Vector representation of a Memory's (decrypted, in-process) content, used for
/// semantic retrieval. A satellite table so re-embedding with a different
/// provider never touches the encrypted Memory row. Vectors are NOT encrypted —
/// see SECURITY.md for why, and what that trades away.
model MemoryEmbedding {
  id         String   @id @default(uuid())
  memory     Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  memoryId   String   @unique
  /// e.g. "local-hashed-256", "voyage-3".
  provider   String
  dimensions Int
  /// JSON-encoded float array.
  vector     String
  createdAt  DateTime @default(now())
}

enum MemoryRelationType {
  RELATES_TO
  SUPERSEDES
  CONTRADICTS
  DERIVED_FROM
  SUPPORTS
}

/// Explicit, always-human-or-detector-created relationships between memories.
/// Never written silently — contradiction detection proposes these via the
/// Proposal system rather than writing them directly.
model MemoryRelation {
  id           String             @id @default(uuid())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  fromMemory   Memory             @relation("FromMemory", fields: [fromMemoryId], references: [id], onDelete: Cascade)
  fromMemoryId String
  toMemory     Memory             @relation("ToMemory", fields: [toMemoryId], references: [id], onDelete: Cascade)
  toMemoryId   String
  type         MemoryRelationType
  note         String?
  confidence   Confidence         @default(LOW)
  createdAt    DateTime           @default(now())
}

enum MemorySourceType {
  USER_STATED
  CONVERSATION
  RESEARCH
  INFERENCE
  SYSTEM
}

model MemorySource {
  id             String           @id @default(uuid())
  memory         Memory           @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  memoryId       String           @unique
  type           MemorySourceType
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  messageId      String?
  researchItem   ResearchItem?    @relation(fields: [researchItemId], references: [id], onDelete: SetNull)
  researchItemId String?
  /// Free-form description of the source when it isn't a message/research item.
  reference      String?
  createdAt      DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Cognitive model: observations, hypotheses, recurring patterns
// ---------------------------------------------------------------------------

enum CognitiveDimension {
  FOCUS
  TASK_SWITCHING
  COMPLETION_BEHAVIOR
  IDEA_GENERATION
  CREATIVITY
  LEARNING_BEHAVIOR
  DECISION_BEHAVIOR
  PLANNING_BEHAVIOR
  CONSISTENCY
  PROJECT_PERSISTENCE
  ATTENTION_PATTERNS
  PRODUCTIVITY_PATTERNS
}

model Observation {
  id         String             @id @default(uuid())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  dimension  CognitiveDimension
  content    String
  evidence   String?
  confidence Confidence         @default(LOW)
  createdAt  DateTime           @default(now())
}

enum HypothesisStatus {
  OPEN
  SUPPORTED
  REJECTED
}

model Hypothesis {
  id         String              @id @default(uuid())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  dimension  CognitiveDimension?
  statement  String
  confidence Confidence          @default(LOW)
  status     HypothesisStatus    @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

enum PatternType {
  REPEATED_IDEA
  EXCESSIVE_BRANCHING
  RECONSIDERATION
  TASK_SWITCHING
  UNRESOLVED_DECISION
  IDEA_WITHOUT_EXECUTION
  PROJECT_ABANDON_RETURN
  OTHER
}

enum PatternStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

/// "Thought-loop" / recurring-pattern detection. Always phrased as a
/// hypothesis ("pattern detected", "possible loop") — never a diagnosis.
model Pattern {
  id              String        @id @default(uuid())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  type            PatternType
  description     String
  confidence      Confidence    @default(LOW)
  status          PatternStatus @default(ACTIVE)
  occurrenceCount Int           @default(1)
  firstDetectedAt DateTime      @default(now())
  lastDetectedAt  DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Projects, goals, tasks, decisions, ideas
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Project {
  id          String        @id @default(uuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  goals         Goal[]
  tasks         Task[]
  decisions     Decision[]
  ideas         Idea[]
  experiments   Experiment[]
  conversations Conversation[]
  knowledgeNode KnowledgeNode?
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ABANDONED
}

model Goal {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  knowledgeNode KnowledgeNode?
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(uuid())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  knowledgeNode KnowledgeNode?
}

enum DecisionStatus {
  PENDING
  DECIDED
  REVISITED
}

model Decision {
  id           String         @id @default(uuid())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId    String?
  title        String
  description  String?
  /// JSON array of alternatives considered.
  alternatives String?
  chosenOption String?
  status       DecisionStatus @default(PENDING)
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  knowledgeNode KnowledgeNode?
}

enum IdeaStatus {
  CAPTURED
  EXPLORING
  IN_EXPERIMENT
  EXECUTED
  ABANDONED
}

model Idea {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  title       String
  description String?
  status      IdeaStatus @default(CAPTURED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  experiments   Experiment[]
  knowledgeNode KnowledgeNode?
}

// ---------------------------------------------------------------------------
// Experiments
// ---------------------------------------------------------------------------

enum ExperimentStatus {
  PLANNED
  RUNNING
  COMPLETED
  ABANDONED
}

model Experiment {
  id         String           @id @default(uuid())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  idea       Idea?            @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  ideaId     String?
  hypothesis String
  method     String?
  status     ExperimentStatus @default(PLANNED)
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  results       ExperimentResult[]
  knowledgeNode KnowledgeNode?
}

model ExperimentResult {
  id           String     @id @default(uuid())
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  experimentId String
  outcome      String
  learnings    String?
  confidence   Confidence @default(MEDIUM)
  createdAt    DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// Research
// ---------------------------------------------------------------------------

model ResearchItem {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  query       String
  provider    String
  title       String?
  sourceUrl   String?
  summary     String?
  relevance   Float?
  confidence  Confidence @default(MEDIUM)
  retrievedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())

  memorySources MemorySource[]
  knowledgeNode KnowledgeNode?
}

// ---------------------------------------------------------------------------
// Minimal knowledge graph
// ---------------------------------------------------------------------------

enum KnowledgeNodeType {
  ENTITY
  TOPIC
  PROJECT
  GOAL
  CONCEPT
  PERSON
  ORGANIZATION
  OTHER
}

/// A node either mirrors a first-class VOX record (exactly one of the link
/// columns below is set — real FK, real cascade-delete) or is a free-floating
/// entity the record model doesn't cover (Person/Organization/Concept/Topic —
/// all link columns null). Prisma has no native polymorphic association, and
/// a string-typed entityId would give up referential integrity, so this is
/// explicit columns rather than a generic entityType/entityId pair.
model KnowledgeNode {
  id          String            @id @default(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  label       String
  type        KnowledgeNodeType @default(ENTITY)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  memoryId       String?       @unique
  memory         Memory?       @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  projectId      String?       @unique
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  goalId         String?       @unique
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  taskId         String?       @unique
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  decisionId     String?       @unique
  decision       Decision?     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  ideaId         String?       @unique
  idea           Idea?         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  experimentId   String?       @unique
  experiment     Experiment?   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  researchItemId String?       @unique
  researchItem   ResearchItem? @relation(fields: [researchItemId], references: [id], onDelete: Cascade)

  outgoing KnowledgeConnection[] @relation("FromNode")
  incoming KnowledgeConnection[] @relation("ToNode")
}

model KnowledgeConnection {
  id         String        @id @default(uuid())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  fromNode   KnowledgeNode @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  fromNodeId String
  toNode     KnowledgeNode @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  /// Short relation label, e.g. "owns", "related_to", "goal".
  relation   String
  createdAt  DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Permissions, integrations, audit events
// ---------------------------------------------------------------------------

model Permission {
  id         String          @id @default(uuid())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  /// Scoped capability key, e.g. "research.web", "integration.gmail.send".
  capability String
  level      CapabilityLevel @default(OBSERVE)
  granted    Boolean         @default(false)
  grantedAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, capability])
}

model Integration {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// e.g. "anthropic", "research-mock".
  name      String
  enabled   Boolean  @default(false)
  /// Non-secret JSON configuration only — never store API keys here.
  config    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

/// Append-only audit log AND durable domain timeline: every consequential
/// (RECOMMEND/ASK/ACT-level) action is recorded here, as is every notable
/// domain state change (task completed, goal changed, research discovered,
/// memory updated/superseded, decision made, experiment result, project
/// milestone). `subjectId` is intentionally NOT a foreign key — an event
/// describing a deleted record must still be readable after that record is
/// gone.
model Event {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  type          String
  /// JSON payload with event-specific details.
  payload       String?
  /// Descriptive-only, e.g. "Task" / "Goal" / "Memory" — not a foreign key.
  subjectType   String?
  subjectId     String?
  consequential Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Cognition proposal engine
// ---------------------------------------------------------------------------

enum ProposalStatus {
  PROPOSED
  APPROVED
  DENIED
  EXPIRED
  EXECUTED
  FAILED
}

/// "Observed X. Connected it with Y. Possible implication: Z. Suggested
/// action: A. Permission required." A Proposal is always PROPOSED first;
/// nothing here executes without approveProposal() succeeding a real
/// enforceCapability() check (src/lib/permissions/service.ts) — see
/// PHASE_2_ARCHITECTURE.md §5.
model Proposal {
  id              String          @id @default(uuid())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  observation     String
  connection      String?
  implication     String?
  suggestedAction String
  /// Machine key into the fixed, internal-only action registry, e.g.
  /// "memory.create_relation", "task.create".
  actionType      String
  /// JSON — concrete params passed to the action handler if approved.
  actionPayload   String
  /// Permission capability key checked before executing.
  capability      String
  requiredLevel   CapabilityLevel @default(RECOMMEND)
  confidence      Confidence      @default(LOW)
  /// JSON: { memoryIds, researchItemIds, observationIds, eventIds }
  evidence        String?
  status          ProposalStatus  @default(PROPOSED)
  /// Outcome text once executed, or the denial reason.
  result          String?
  createdAt       DateTime        @default(now())
  resolvedAt      DateTime?
}
