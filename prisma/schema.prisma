// ---------------------------------------------------------------------------
// Suit Bay
// ---------------------------------------------------------------------------

/// Structured suit design vocabulary — the "source of truth" a suit's
/// holographic 3D visualization is deterministically rendered FROM (never
/// the reverse). Lives on LabSuit (identity-level, like color) rather than
/// per-version: silhouette/material-language/pattern read as the suit's
/// design language, not something that changes every iteration the way
/// stats do — see ARCHITECTURE.md.
enum LabSilhouette {
  ATHLETIC
  STREAMLINED
  ARMORED
  TACTICAL
  LIGHTWEIGHT
  STEALTH
}

enum LabMaterialLanguage {
  TEXTILE
  CARBON_COMPOSITE
  SYNTHETIC_FIBER
  FLEXIBLE_POLYMER
  EXPERIMENTAL_MATERIAL
}

enum LabPatternStyle {
  WEB_GEOMETRY
  GEOMETRIC
  ORGANIC
  TECHNICAL
  MINIMAL
}

enum LabArmorLevel {
  NONE
  LIGHT
  MODERATE
  EXPERIMENTAL
}

enum LabMaskLensStyle {
  NARROW
  WIDE
  ANGULAR
  ROUND
  MECHANICAL
}

/// Buildability/reality axis — deliberately separate from LabConfidence
/// (evidence quality) and LabDesignStatus (workflow state). Answers "could
/// this exist" not "how sure are we" or "what stage is it in". Defaults to
/// the most conservative value (CONCEPT) so nothing is claimed real by
/// omission — matches the "never silently upgrade" posture used for
/// LabConfidence, applied to this axis instead.
///  REAL          — a physical component/suit that has actually been built.
///  BUILDABLE     — sourceable parts + a real fabrication path exist today.
///  PROTOTYPE     — partially built or bench-tested, not yet a full suit.
///  EXPERIMENTAL  — physically plausible but unproven / no build path yet.
///  CONCEPT       — design-stage only, no claim of real-world buildability.
///  NOT_CONNECTED — fictional/reference material with no real-world tie-in.
enum LabRealityStatus {
  REAL
  BUILDABLE
  PROTOTYPE
  EXPERIMENTAL
  CONCEPT
  NOT_CONNECTED
}

model LabSuit {
  id          String          @id @default(uuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     LabProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  codename    String
  designation String          @default("MK-I")
  /// Intended-use archetype, e.g. "Stealth", "Combat", "Recon", "Utility", "Experimental".
  archetype   String
  description String?
  colorPrimary   String       @default("#a855f7")
  colorSecondary String       @default("#0a0616")
  /// Design-parameter vocabulary driving the 3D holographic render — see
  /// LabSilhouette etc. above. All default to a sensible baseline so
  /// existing rows created before this field remain renderable.
  silhouette       LabSilhouette       @default(ATHLETIC)
  materialLanguage LabMaterialLanguage @default(TEXTILE)
  patternStyle     LabPatternStyle     @default(WEB_GEOMETRY)
  armorLevel       LabArmorLevel       @default(LIGHT)
  maskLensStyle    LabMaskLensStyle    @default(ANGULAR)
  /// Buildability/reality status — see LabRealityStatus. Independent of
  /// `status` (workflow state) and never inferred from it.
  realityStatus LabRealityStatus @default(CONCEPT)
  /// Path (under /public/models/suits/) to a real .glb/.gltf asset, e.g.
  /// "/models/suits/mk-vii.glb". Null by default — every suit renders via
  /// the procedural SuitRig visualization until a real 3D scan/model file is
  /// actually placed on disk and this is set. Never fabricated or assumed;
  /// see /public/models/suits/README.md.
  modelUrl    String?
  status      LabDesignStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  versions        LabSuitVersion[] @relation("SuitVersions")
  currentVersion   LabSuitVersion? @relation("SuitCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  currentVersionId String?         @unique
  components      LabComponent[]
  simulations     LabSimulation[]
  experiments     LabExperiment[]
  requirements    LabRequirement[]
  engineeringQuestions LabEngineeringQuestion[]
  decisions       LabDecision[]
  images          LabSuitImage[]
}

enum LabSuitImageKind {
  CONCEPT
  FRONT
  REAR
  SIDE
  DETAIL
}

/// A real, externally-produced concept-art asset for a suit — referenced by
/// URL, exactly like LabSuit.modelUrl already references a .glb file. VOX
/// never generates this image itself (no image-generation provider is
/// configured in this project — see /public/models/suits/README.md for the
/// same posture applied to 3D assets); a human (or a future dedicated
/// image-generation workflow) supplies the URL after producing/approving
/// the artwork. A suit with zero LabSuitImage rows is the honest default —
/// the Lab's Cinematic presentation shows a clearly-labeled "concept art
/// not yet produced" state rather than pretending the procedural
/// holographic render is finished artwork.
model LabSuitImage {
  id        String           @id @default(uuid())
  suit      LabSuit          @relation(fields: [suitId], references: [id], onDelete: Cascade)
  suitId    String
  kind      LabSuitImageKind
  url       String
  /// Optional free-text caption, e.g. "Detail — chest emblem, close-up".
  label     String?
  createdAt DateTime         @default(now())
}

/// One snapshot in a suit's design history. Components live on the parent
/// LabSuit (not versioned individually) — each version snapshots metadata +
/// a full stats block, which is enough to diff/compare versions meaningfully
/// without doubling the component-tree storage. Documented simplification;
/// see NEXT DEVELOPMENT FRONTIER in the build report.
model LabSuitVersion {
  id         String    @id @default(uuid())
  suit       LabSuit   @relation("SuitVersions", fields: [suitId], references: [id], onDelete: Cascade)
  suitId     String
  label      String
  note       String?
  archived   Boolean   @default(false)
  parent     LabSuitVersion?  @relation("SuitVersionLineage", fields: [parentId], references: [id], onDelete: SetNull)
  parentId   String?
  children   LabSuitVersion[] @relation("SuitVersionLineage")
  createdAt  DateTime  @default(now())

  stats        LabSuitStats?
  currentOfSuit LabSuit?      @relation("SuitCurrentVersion")

  @@unique([suitId, label])
}

model LabSuitStats {
  id             String         @id @default(uuid())
  version        LabSuitVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId      String         @unique
  stealth                  Int   // 0-100
  durability               Int   // 0-100
  mobility                 Int   // 0-100
  stretchiness             Int   // 0-100
  weightKg                 Float
  thermalLoadC             Float
  protection               Int   // 0-100
  environmentalResistance  Int   // 0-100
  manufacturingComplexity  Int   // 0-100
  estimatedBuildHours      Float
  estimatedCostUsd         Float
  flexibility              Int   // 0-100
  impactResistance         Int   // 0-100
  visibility               Int   // 0-100 (higher = more visible/less stealthy)
  noiseProfile             Int   // 0-100 (higher = louder)
  sensorCapacity           Int   // 0-100
  energyRequirementW       Float
  maintenanceComplexity    Int   // 0-100
  confidence               LabConfidence @default(ESTIMATED)
}

// ---------------------------------------------------------------------------
// Component hierarchy — shared by suits AND gadgets (Fallout-style inspection)
// ---------------------------------------------------------------------------

/// Body-region taxonomy for suit components — the digital-twin backbone.
/// Nullable on LabComponent so existing free-text components (and gadget
/// components, which don't have a body region) aren't forced to guess one.
/// CORE is for cross-cutting systems (power, comms, compute) that don't
/// belong to one region.
enum LabSubsystem {
  HEAD
  TORSO
  ARMS
  LEGS
  FEET
  CORE
}

enum LabRiskLevel {
  LOW
  MODERATE
  HIGH
  UNKNOWN
}

model LabComponent {
  id          String        @id @default(uuid())
  parent      LabComponent? @relation("ComponentTree", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String?
  children    LabComponent[] @relation("ComponentTree")
  suit        LabSuit?      @relation(fields: [suitId], references: [id], onDelete: Cascade)
  suitId      String?
  gadget      LabGadget?    @relation(fields: [gadgetId], references: [id], onDelete: Cascade)
  gadgetId    String?
  name        String
  description String?
  material    LabMaterial?  @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialId  String?
  massKg      Float?
  notes       String?
  confidence  LabConfidence @default(ESTIMATED)
  order       Int           @default(0)
  /// Body region this component belongs to — null for gadget components and
  /// any suit component not yet classified. See LabSubsystem.
  subsystem     LabSubsystem?
  powerDrawW    Float?
  costUsd       Float?
  riskLevel     LabRiskLevel     @default(UNKNOWN)
  /// Buildability/reality status at the COMPONENT level — independent of
  /// the parent suit's own LabRealityStatus. A suit can be BUILDABLE
  /// overall while one experimental subsystem is still CONCEPT.
  realityStatus LabRealityStatus @default(CONCEPT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  dependsOn    LabComponentDependency[] @relation("ComponentDependsOn")
  dependedOnBy LabComponentDependency[] @relation("ComponentDependedOnBy")
  experiments  LabExperiment[]
  researchItems LabResearchItem[]
  requirements LabRequirement[]
}

/// A component's dependency on another component (e.g. "HUD" depends on
/// "Power Core"). Directional, many-to-many via join rows rather than a
/// self-relation array, since Prisma/SQLite has no native array-of-FK type.
model LabComponentDependency {
  id           String       @id @default(uuid())
  component    LabComponent @relation("ComponentDependsOn", fields: [componentId], references: [id], onDelete: Cascade)
  componentId  String
  dependsOn    LabComponent @relation("ComponentDependedOnBy", fields: [dependsOnId], references: [id], onDelete: Cascade)
  dependsOnId  String
  note         String?
  createdAt    DateTime     @default(now())

  @@unique([componentId, dependsOnId])
}

// ---------------------------------------------------------------------------
// Engineering Bay — gadgets
// ---------------------------------------------------------------------------

model LabGadget {
  id          String          @id @default(uuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     LabProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  name        String
  category    String
  description String?
  status      LabDesignStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  versions         LabGadgetVersion[] @relation("GadgetVersions")
  currentVersion   LabGadgetVersion?  @relation("GadgetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  currentVersionId String?            @unique
  components       LabComponent[]
  simulationLinks  LabSimulationGadget[]
}

model LabGadgetVersion {
  id        String    @id @default(uuid())
  gadget    LabGadget @relation("GadgetVersions", fields: [gadgetId], references: [id], onDelete: Cascade)
  gadgetId  String
  label     String
  note      String?
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())

  stats          LabGadgetStats?
  currentOfGadget LabGadget?     @relation("GadgetCurrentVersion")

  @@unique([gadgetId, label])
}

model LabGadgetStats {
  id                      String         @id @default(uuid())
  version                 LabGadgetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId               String         @unique
  massKg                  Float
  powerRequirementW       Float
  batteryLifeHours        Float
  durability              Int // 0-100
  sensorAccuracy          Int // 0-100
  rangeM                  Float
  manufacturingComplexity Int // 0-100
  estimatedCostUsd        Float
  reliability             Int // 0-100
  confidence              LabConfidence @default(ESTIMATED)
}

// ---------------------------------------------------------------------------
// Materials database
// ---------------------------------------------------------------------------

model LabMaterial {
  id                       String        @id @default(uuid())
  /// Null for the shared seed catalog; set for a user-authored custom material.
  userId                   String?
  name                     String
  category                 String
  densityGCm3              Float
  tensileStrengthMpa       Float
  elasticityPercent        Float
  abrasionResistance       Int   // 0-100
  temperatureResistanceC   Float
  moistureResistance       Int   // 0-100
  costPerKgUsd             Float
  notes                    String?
  confidence               LabConfidence @default(ESTIMATED)
  createdAt                DateTime      @default(now())

  components LabComponent[]
}

// ---------------------------------------------------------------------------
// Web Lab — theoretical web-system research (see safety framing in
// ARCHITECTURE.md: simulation never implies real-world validation)
// ---------------------------------------------------------------------------

model LabWebProfile {
  id          String      @id @default(uuid())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  project     LabProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  material   LabWebMaterial?
  deployment LabWebDeployment?
  attachment LabWebAttachment?
  loadModels LabWebLoadModel[]
  simulations LabSimulation[]
}

model LabWebMaterial {
  id                     String        @id @default(uuid())
  profile                LabWebProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId              String        @unique
  densityGCm3            Float
  tensileStrengthMpa     Float
  elasticityPercent      Float
  abrasionResistance     Int // 0-100
  temperatureResistanceC Float
  moistureResistance     Int // 0-100
  storageVolumeCm3       Float
  massG                  Float
  confidence             LabConfidence @default(HYPOTHETICAL)
}

model LabWebDeployment {
  id                       String        @id @default(uuid())
  profile                  LabWebProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                String        @unique
  deploymentSpeedMs        Float
  lineLengthM              Float
  cartridgeSizeCm3         Float
  systemMassG              Float
  energyRequirementJ       Float
  deploymentReliabilityPct Int // 0-100
  confidence               LabConfidence @default(HYPOTHETICAL)
}

model LabWebAttachment {
  id                              String        @id @default(uuid())
  profile                         LabWebProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                       String        @unique
  attachmentType                  String
  theoreticalHoldingStrengthN     Float
  environmentalAssumptions        String
  geometry                        String
  structuralAssumptions           String
  estimatedFailureProbabilityPct  Float
  confidence                      LabConfidence @default(HYPOTHETICAL)
}

/// A single theoretical load calculation for a web profile under an assumed
/// scenario. Always HYPOTHETICAL/ESTIMATED — this system never certifies a
/// design as validated for real human load-bearing use (see SECURITY.md-style
/// framing in ARCHITECTURE.md for the Web Lab).
model LabWebLoadModel {
  id               String        @id @default(uuid())
  profile          LabWebProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  label            String
  userMassKg       Float
  equipmentMassKg  Float
  swingRadiusM     Float
  velocityMs       Float
  staticLoadN      Float
  dynamicLoadN     Float
  accelerationMs2  Float
  forceN           Float
  tensionN         Float
  safetyMarginPct  Float
  confidence       LabConfidence @default(HYPOTHETICAL)
  createdAt        DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Simulation Center
// ---------------------------------------------------------------------------

model LabScenario {
  id              String                   @id @default(uuid())
  /// Null for seed scenarios; set for a user-generated custom scenario
  /// (Scenario Generator).
  user            User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?
  name            String
  environment     LabScenarioEnvironment
  objectiveType   LabScenarioObjectiveType
  difficulty      LabDifficulty
  description     String?
  timeOfDay       String   @default("day")
  precipitation   String   @default("none")
  windMs          Float    @default(0)
  temperatureC    Float    @default(18)
  fogPercent      Int      @default(0)
  gravityMs2      Float    @default(9.81)
  surfaceType     String   @default("concrete")
  elevationM      Float    @default(0)
  obstacleCount   Int      @default(0)
  isCustom        Boolean  @default(false)
  createdAt       DateTime @default(now())

  simulations      LabSimulation[]
  trainingSessions LabTrainingSession[]
}

model LabSimulation {
  id                    String       @id @default(uuid())
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  project               LabProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId             String?
  name                  String
  scenario              LabScenario  @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  scenarioId            String
  suit                  LabSuit?     @relation(fields: [suitId], references: [id], onDelete: SetNull)
  suitId                String?
  webProfile            LabWebProfile? @relation(fields: [webProfileId], references: [id], onDelete: SetNull)
  webProfileId          String?
  userMassKg            Float        @default(75)
  reactionTimeMs         Float       @default(250)
  skillLevel             Int         @default(50) // 0-100
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  gadgets LabSimulationGadget[]
  runs    LabSimulationRun[]
  /// Set once a simulation RUN completes and its measured telemetry is
  /// written back as an OBSERVATION memory — see
  /// src/lib/lab/learning.ts#recordSimulationRunExperience. The node exists
  /// so the model output is reachable from the rest of the graph; it is
  /// always labelled as a model result, never as a physical measurement.
  knowledgeNode KnowledgeNode?
}

model LabSimulationGadget {
  simulation   LabSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  simulationId String
  gadget       LabGadget     @relation(fields: [gadgetId], references: [id], onDelete: Cascade)
  gadgetId     String

  @@id([simulationId, gadgetId])
}

/// One executed run of a LabSimulation. `telemetry` is a JSON time-series
/// (list of {t, position, velocity, accelerationMs2, forceN, thermalLoadC,
/// fatiguePercent} samples) — genuinely variable-length experimental output,
/// which is the documented case where JSON is preferable to one row per
/// sample (see CLAUDE.md project layout notes).
model LabSimulationRun {
  id                 String               @id @default(uuid())
  simulation         LabSimulation        @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  simulationId       String
  status             LabSimulationStatus  @default(DRAFT)
  seed               Int
  durationS          Float
  telemetry          String               // JSON array of samples
  peakVelocityMs     Float?
  peakForceN         Float?
  peakThermalLoadC   Float?
  fatigueEstimatePct Float?
  warnings           String?              // JSON string[]
  /// JSON array of {category, explanation, suggestion} — structured failure
  /// analysis (never just "simulation failed"), populated whenever the run's
  /// modeled thresholds are exceeded. Empty array when nothing failed.
  failureAnalysis    String?
  summary            String?
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  createdAt          DateTime             @default(now())

  experiments LabExperiment[]
}

// ---------------------------------------------------------------------------
// Experiments
// ---------------------------------------------------------------------------

model LabExperiment {
  id               String               @id @default(uuid())
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  project          LabProject?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId        String?
  code             String
  title            String
  hypothesis       String
  objective        String?
  /// JSON array of {name, value, unit} — flexible experimental variables.
  variables        String?
  equipmentNotes   String?
  environmentNotes String?
  expectedOutcome  String?
  status           LabExperimentStatus  @default(PLANNED)
  suit             LabSuit?             @relation(fields: [suitId], references: [id], onDelete: SetNull)
  suitId           String?
  /// Optional: the specific subsystem/component this experiment targets,
  /// rather than "the suit generally". Null is valid (whole-suit
  /// experiments still make sense).
  component        LabComponent?        @relation(fields: [componentId], references: [id], onDelete: SetNull)
  componentId      String?
  simulationRun    LabSimulationRun?    @relation(fields: [simulationRunId], references: [id], onDelete: SetNull)
  simulationRunId  String?
  confidence       LabConfidence        @default(HYPOTHETICAL)
  nextIteration    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  results LabExperimentResult[]
  requirements LabRequirement[]
  /// Set once a result is recorded against this experiment — see
  /// src/lib/lab/learning.ts#recordExperimentResultExperience.
  knowledgeNode KnowledgeNode?

  @@unique([userId, code])
}

model LabExperimentResult {
  id           String        @id @default(uuid())
  experiment   LabExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  experimentId String
  outcome      String
  learnings    String?
  confidence   LabConfidence @default(ESTIMATED)
  createdAt    DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Training Center
// ---------------------------------------------------------------------------

model LabTrainingModule {
  id                     String              @id @default(uuid())
  name                   String
  category               LabTrainingCategory
  difficulty             LabDifficulty
  description            String
  objective              String
  durationMinutesEstimate Int
  createdAt              DateTime            @default(now())

  sessions LabTrainingSession[]
}

model LabTrainingSession {
  id                       String            @id @default(uuid())
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   String
  module                   LabTrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId                 String
  scenario                 LabScenario?      @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  scenarioId               String?
  reactionTimeMs           Float?
  completionTimeS          Float?
  movementEfficiencyPercent Float?
  staminaUsedPercent       Float?
  balanceScore             Float?
  accuracyPercent          Float?
  decisionQualityPercent   Float?
  defensiveSuccessPercent  Float?
  mistakes                 Int?
  score                    Int               // 0-100 composite
  notes                    String?
  startedAt                DateTime          @default(now())
  completedAt              DateTime?
  createdAt                DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// Tutorials
// ---------------------------------------------------------------------------

model LabTutorial {
  id               String               @id @default(uuid())
  title            String
  category         LabTutorialCategory
  difficulty       LabDifficulty
  lesson           String
  demonstration    String?
  exercisePrompt   String?
  /// JSON array of {question, options: string[], answerIndex}.
  quiz             String?
  prerequisite     LabTutorial?         @relation("TutorialPrereq", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  prerequisiteId   String?
  unlocks          LabTutorial[]        @relation("TutorialPrereq")
  createdAt        DateTime             @default(now())

  progress LabTutorialProgress[]
}

model LabTutorialProgress {
  id          String      @id @default(uuid())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  tutorial    LabTutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  tutorialId  String
  completed   Boolean     @default(false)
  score       Int?
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  @@unique([userId, tutorialId])
}

// ---------------------------------------------------------------------------
// Design notes — free-text annotations attachable to any lab entity
// ---------------------------------------------------------------------------

/// `subjectType`/`subjectId` are descriptive-only (e.g. "LabSuit"/id), not a
/// foreign key — same convention as Event.subjectId, so a note survives its
/// subject's deletion and one model covers every annotatable entity without
/// a polymorphic relation Prisma can't express.
model LabDesignNote {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  subjectType String
  subjectId   String
  content     String
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Research Engine
// ---------------------------------------------------------------------------

enum LabResearchCategory {
  MATERIALS
  TEXTILES
  POLYMERS
  COMPOSITES
  ROBOTICS
  WEARABLE_TECHNOLOGY
  SENSORS
  PHYSICS
  BIOMECHANICS
  THERMAL_MANAGEMENT
  MANUFACTURING
  PROTECTIVE_EQUIPMENT
}

/// A single research finding/note the lab is tracking — deliberately
/// separate from VOX's own ResearchItem (which is web-search-provider
/// output for the cognitive OS); this is lab-internal engineering research
/// the user records by hand or via the AI Lab Engineer, always confidence-
/// tagged like every other lab claim.
model LabResearchItem {
  id         String              @id @default(uuid())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  project    LabProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  /// Optional: the specific component this research finding informs.
  component   LabComponent?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  componentId String?
  title      String
  category   LabResearchCategory
  source     String?
  sourceDate DateTime?
  confidence LabConfidence       @default(ESTIMATED)
  /// 0-100 — how relevant this finding is to current lab work.
  relevance  Int                 @default(50)
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

// ---------------------------------------------------------------------------
// Engineering domain — requirements, open questions, decisions
// (Lab Cinematic/Engineering mode split)
// ---------------------------------------------------------------------------

/// Verification-workflow stage — deliberately a separate axis from
/// LabConfidence (evidence quality of a single claim). A requirement can
/// only reach VERIFIED through real evidence recorded on `evidence`/
/// `verificationMethod`; nothing in this app sets it there automatically.
enum LabRequirementStatus {
  HYPOTHESIS
  MODELED
  TESTED
  VERIFIED
}

enum LabPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A concrete, testable engineering requirement — "what the system must
/// accomplish" — for Engineering Mode's REQUIREMENTS section.
model LabRequirement {
  id          String        @id @default(uuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  suit        LabSuit?      @relation(fields: [suitId], references: [id], onDelete: Cascade)
  suitId      String?
  code        String
  title       String
  description String?
  priority    LabPriority   @default(MEDIUM)
  status      LabRequirementStatus @default(HYPOTHESIS)
  verificationMethod String?
  evidence    String?
  subsystem   LabSubsystem?
  component   LabComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  componentId String?
  experiment  LabExperiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  experimentId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// A first-class unresolved engineering question — something concrete for
/// VOX (or the user) to go investigate, distinct from a vague TODO.
model LabEngineeringQuestion {
  id                String        @id @default(uuid())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  suit              LabSuit?      @relation(fields: [suitId], references: [id], onDelete: Cascade)
  suitId            String?
  question          String
  importance        LabPriority   @default(MEDIUM)
  subsystem         LabSubsystem?
  researchStatus    String?
  currentHypothesis String?
  confidence        LabConfidence @default(HYPOTHETICAL)
  nextAction        String?
  resolved          Boolean       @default(false)
  answer            String?
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

/// A structured engineering decision log entry — "why a design choice was
/// made" — permanent project memory, never overwritten (create a new row
/// for a later reversal/superseding decision rather than editing history).
model LabDecision {
  id             String        @id @default(uuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  suit           LabSuit?      @relation(fields: [suitId], references: [id], onDelete: Cascade)
  suitId         String?
  decision       String
  context        String?
  /// JSON string[] of options that were considered.
  options        String?
  selectedOption String?
  rationale      String?
  evidence       String?
  tradeoffs      String?
  author         String        @default("user")
  confidence     LabConfidence @default(ESTIMATED)
  createdAt      DateTime      @default(now())
}

/// Links a REAL core ResearchItem (VOX's web-search-backed research) to any
/// Lab engineering object, so Lab objects can reference existing research
/// instead of duplicating it inside the Lab — LabResearchItem (above) stays
/// a separate, deliberately distinct concept for hand-entered/AI-Lab-
/// Engineer engineering notes. subjectType/subjectId follows the same
/// polymorphic convention as LabDesignNote.
model LabResearchLink {
  id             String       @id @default(uuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  researchItem   ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  researchItemId String
  subjectType    String
  subjectId      String
  note           String?
  createdAt      DateTime     @default(now())

  @@unique([researchItemId, subjectType, subjectId])
}
