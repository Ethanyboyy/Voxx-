# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal
/prisma/test.db
/prisma/test.db-journal
/prisma/test.db-shm
/prisma/test.db-wal
/src/generated/

# vox local data
/data/

# Agent skill installs (add-skill / plugin tooling) — tooling config, not VOX source
.agents/
.claude/
skills-lock.json

# Python bytecode from the 3D authoring pipeline
__pycache__/
*.pyc

# QA screenshots — regenerated by tools/qa/verify-3d.mjs, not source
/tools/qa/out/

# Local QA database, same rule as dev.db/test.db
prisma/qa.db*
