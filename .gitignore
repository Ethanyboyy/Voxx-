# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal
/prisma/test.db
/prisma/test.db-journal
/prisma/test.db-shm
/prisma/test.db-wal
/src/generated/

# vox local data
/data/

# Agent tooling.
#
# VOX's own engineering configuration IS source and is committed: the
# permission/hook settings, the project commands, the specialised agents, and
# the hook scripts they run. Before this carve-out the whole of .claude/ was
# ignored, so every session started with no permissions, no hooks and no
# commands, and each one re-derived the same conventions from CLAUDE.md. A
# fresh clone now reproduces them.
#
# What stays ignored is the VENDOR payload: .claude/skills/ is installed by the
# plugin/skill tooling, is megabytes of third-party material, and is
# reinstallable — committing it would put someone else's content in VOX's
# history for no reproducibility gain. .claude/skills/README.md is the
# exception, so a fresh clone still learns which skills this project expects.
.agents/
.claude/*
!.claude/settings.json
!.claude/README.md
!.claude/commands/
!.claude/agents/
!.claude/hooks/
# Skills: keep the DIRECTORY visible, ignore its CONTENTS, then let the README
# back through. All three lines are required and the order matters — git cannot
# re-include a file whose parent directory is excluded, so `.claude/*` above
# would otherwise make the final negation silently dead.
#
# The entries under it are symlinks into `.agents/skills/` (a shared store), so
# what is ignored here is a set of links, not the payload itself.
!.claude/skills/
.claude/skills/*
!.claude/skills/README.md
# Never commit local/personal overrides or any secret a tool may cache here.
.claude/settings.local.json
.claude/.credentials.json
.claude/*.local.json
skills-lock.json

# Python bytecode from the 3D authoring pipeline
__pycache__/
*.pyc

# QA screenshots — regenerated by tools/qa/verify-3d.mjs, not source
/tools/qa/out/

# Local QA database, same rule as dev.db/test.db
prisma/qa.db*
# CI datasource path (see .github/workflows/verify.yml). Prisma's CLI needs a
# resolvable DATABASE_URL to load prisma.config.ts; nothing creates this file,
# but it is ignored so a local run of the same command cannot leave one behind.
prisma/ci.db*

# Generated artifact bytes (images, video, models produced by providers).
# User content, not source — same class as prisma/dev.db. The ArtifactVersion
# rows that point at these live in the database, which is also not committed.
/public/artifacts/
