# Copy this file to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
# SQLite file, local-first by default. Relative paths are resolved from the
# project root (see prisma.config.ts / src/lib/db.ts).
DATABASE_URL="file:./prisma/dev.db"

# --- AI provider ----------------------------------------------------------
# Anthropic API key. Required for real (non-mock) chat responses.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Set to "mock" to force the mock AI provider (no API key required, used
# automatically in tests). Leave unset to use Anthropic when a key is present.
VOX_AI_PROVIDER=""
VOX_ANTHROPIC_MODEL=""
VOX_AI_TIMEOUT_MS=""
VOX_AI_MAX_RETRIES=""

# Optional: enables real dollar cost estimates in diagnostics. Left unset,
# VOX reports token counts only rather than guess at pricing.
VOX_COST_PER_1K_INPUT_TOKENS=""
VOX_COST_PER_1K_OUTPUT_TOKENS=""

# --- Research provider ------------------------------------------------------
# Phase 1 ships only a mock research provider (no external calls). This flag
# is reserved for future real providers behind the same abstraction.
VOX_RESEARCH_PROVIDER="mock"

# --- Security ---------------------------------------------------------------
# 32-byte key (base64 or hex) used to encrypt sensitive memory content at
# rest. Generate with: openssl rand -base64 32
VOX_ENCRYPTION_KEY=""

# Random secret used to sign/verify session cookies.
# Generate with: openssl rand -base64 32
VOX_SESSION_SECRET=""

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"
