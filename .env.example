# Copy this file to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
# SQLite file, local-first by default. Relative paths are resolved from the
# project root (see prisma.config.ts / src/lib/db.ts).
DATABASE_URL="file:./prisma/dev.db"

# --- AI provider ----------------------------------------------------------
# Anthropic API key. Required for real (non-mock) chat responses.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Set to "mock" to force the mock AI provider (no API key required, used
# automatically in tests). Leave unset to use Anthropic when a key is present.
VOX_AI_PROVIDER=""
VOX_ANTHROPIC_MODEL=""
VOX_AI_TIMEOUT_MS=""
VOX_AI_MAX_RETRIES=""

# Optional: enables real dollar cost estimates in diagnostics. Left unset,
# VOX reports token counts only rather than guess at pricing.
VOX_COST_PER_1K_INPUT_TOKENS=""
VOX_COST_PER_1K_OUTPUT_TOKENS=""

# --- Research provider ------------------------------------------------------
# "mock" (default) makes no network calls. Set to "anthropic" to enable real
# web research via Claude's native web_search tool — reuses ANTHROPIC_API_KEY
# above, no separate signup. See PHASE_2_ARCHITECTURE.md §2.
VOX_RESEARCH_PROVIDER="mock"
# Max web searches Claude may run per research query. Each one costs against
# your Anthropic usage.
VOX_WEB_SEARCH_MAX_USES=""

# --- Semantic memory (embeddings) --------------------------------------------
# Default is a local, zero-network, zero-third-party embedding — memory
# content never leaves the device. Setting VOYAGE_API_KEY switches to real
# neural embeddings via Voyage AI (Anthropic's recommended embedding
# partner), which DOES send memory content to a third party. Opt-in only —
# see SECURITY.md before enabling.
VOYAGE_API_KEY=""
VOX_VOYAGE_MODEL=""

# --- Connections Hub (external integrations) --------------------------------
# All unset by default and left unset here intentionally — see SECURITY.md
# "Connections Hub". No connection can reach CONNECTED without these; setting
# any of them is a real authorization decision, not a config convenience.
# See src/lib/integrations/catalog.ts for the full service list.
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# NOTION_OAUTH_CLIENT_ID=""
# NOTION_OAUTH_CLIENT_SECRET=""
# TODOIST_OAUTH_CLIENT_ID=""
# TODOIST_OAUTH_CLIENT_SECRET=""
# CRAFT_API_KEY=""
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# GOOGLE_MAPS_API_KEY=""
# ETSY_OAUTH_CLIENT_ID=""
# ETSY_OAUTH_CLIENT_SECRET=""
# PRINTFUL_API_KEY=""
# PRINTIFY_API_KEY=""

# --- Security ---------------------------------------------------------------
# 32-byte key (base64 or hex) used to encrypt sensitive memory content at
# rest. Generate with: openssl rand -base64 32
VOX_ENCRYPTION_KEY=""

# Random secret used to sign/verify session cookies.
# Generate with: openssl rand -base64 32
VOX_SESSION_SECRET=""

# --- 3D asset generation ------------------------------------------------------
# Path to a Python interpreter that has Blender's `bpy` module installed
# (python -m venv .bpy && .bpy/bin/pip install bpy). Absent by default: without
# it the generation provider reports itself unavailable and refuses to run,
# rather than producing a stand-in asset.
#
# This is a LOCAL toolchain — bpy is Blender itself, imported in-process. It
# sends nothing to any third party. No hosted 3D generation service is wired up;
# see docs/3d-pipeline/MCP_DECISIONS.md for why, and for what adding one would
# require (strictly opt-in behind its own env var, per CLAUDE.md rule 6).
# VOX_BLENDER_PYTHON=""

# --- AI 3D generation engines -------------------------------------------------
# Absent by default. Both engines are hosted third-party services that receive
# prompts and reference images, so per CLAUDE.md rule 6 they are strictly
# opt-in: without these the generation providers report themselves unavailable
# and refuse to run rather than falling back to anything.
#
# NOTE: a key alone is not sufficient in this environment. api.tripo3d.ai and
# api.meshy.ai are currently denied by the organizational egress policy, so the
# hosts must also be allowlisted. See docs/3d-pipeline/AI_GENERATION_ARCHITECTURE.md
# TRIPO_API_KEY=""
# MESHY_API_KEY=""

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"

# --- Multimodal agent fabric ------------------------------------------------
# See MULTIMODAL_FABRIC_ARCHITECTURE.md. Both providers below are ABSENT BY
# DEFAULT (CLAUDE.md rule 6): each sends user content to a third party, so
# setting one is a real authorization decision, not a config convenience.
# With neither set, VOX reports image and video generation as unavailable and
# refuses to produce a placeholder — it will not fabricate an asset.

# Google Gemini image generation ("Nano Banana"). Sends prompts and any
# reference images to Google. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=""
# Override the image model id. Google's image model names move faster than
# this repository; an unknown id surfaces as a real 404 from the API rather
# than as a silent fallback.
VOX_GEMINI_IMAGE_MODEL=""

# Higgsfield cinematic generation. Sends prompts and reference frames to
# Higgsfield.
#
# NOTE: Higgsfield's hosts are unreachable from some environments — this one
# returns 403 at the egress proxy for both api.higgsfield.ai and
# higgsfield.ai. The adapter therefore requires the base URL to be named
# EXPLICITLY as well as the key, so it cannot report itself connected in an
# environment where its request shape has never been checked against the live
# service. Set both only once you have verified the endpoint.
HIGGSFIELD_API_KEY=""
VOX_HIGGSFIELD_BASE_URL=""
VOX_HIGGSFIELD_MODEL=""
